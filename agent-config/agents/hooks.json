{
    "ruff-autofix-format": {
        "PostToolUse": [
            {
                "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uvx ruff check --select I,F401 --fix && uvx ruff format",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}