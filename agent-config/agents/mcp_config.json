{
    "mcpServers": {
        "codegraph": {
            "command": "npx",
            "args": [
                "-y",
                "@colbymchenry/codegraph",
                "serve",
                "--mcp"
            ],
            "env": {
                "CODEGRAPH_WATCH_DEBOUNCE_MS": "2000"
            }
        },
        "sequential-thinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ]
        },
        "graphify": {
            "command": "graphify",
            "args": [
                "serve",
                "--mcp"
            ]
        }
    }
}
