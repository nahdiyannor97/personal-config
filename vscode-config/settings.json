  "workbench.startupEditor": "none",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.smoothScrolling": false,
  "editor.showFoldingControls": "always",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "**/_pyrefly_virtual_/**",
    "**/__pyrefly_virtual__/**",
  ],
  "python.analysis.ignore": [
    "**/_pyrefly_virtual_/**",
    "**/__pyrefly_virtual__/**",
  ],
  "files.exclude": {
    "**/_pyrefly_virtual_": true,
    "**/__pyrefly_virtual__": true,
  },
  "python.analysis.inlayHints.callArgumentNames": "all",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,
  "editor.codeLens": false,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "codachi.position": "explorer",
  "git.suggestSmartCommit": false,
  "todohighlight.defaultStyle": {},
  "git.ignoreRebaseWarning": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "securecoder.autostartFixes": false,
  "json.schemaDownload.enable": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "ag-usage.notifyOnFullQuota": true,
  "editor.formatOnSave": false,
  "ag-usage.refreshInterval": 30,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "python.terminal.useEnvFile": true,
  "markdown-preview-enhanced.enablePreviewZenMode": true,
  "codachi.showXP": true,
  "workbench.editor.limit.value": 5,
  "python.languageServer": "None",
  "sqltools.useNodeRuntime": true,
  "editor.minimap.enabled": false,
  "ruff.enable": false,
  "workbench.settings.applyToAllProfiles": [
    "python.pyrefly.typeCheckingMode"
  ],
  "python.pyrefly.typeCheckingMode": "off",
  "workbench.colorTheme": "Catppuccin Latte",
  "workbench.iconTheme": "catppuccin-latte",
  "antigravity.enableTelemetry": false,
  "antigravity.autoAcceptOnChat": false,
  "antigravity.enableInlineDiff": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "window.density.layout": "compact",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/.venv/**": true
